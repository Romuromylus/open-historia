# Rebuilt inside the image — never copy the host's versions.
node_modules
dist
dist-ssr

# Runtime state (persisted in a volume, not baked into the image). Scenarios are
# NOT ignored — they are the baked seed content the game ships with.
server/data/games
server/data/basemaps
server/data/mapeditor-documents
server/data/.trash
server/data/hub-cache
server/data/import-pings
server/data/*-manifest.json

# Vendored at runtime, not needed in the image.
fmg

# Logs, editor, OS cruft.
*.log
logs
.vscode
.idea
.DS_Store
*.local

# LFS is resolved from the media host (scripts/resolve-lfs.mjs), not from .git,
# so the build never needs the git history in its context.
.git
